<!-- "Buttons" tab: button and stick mapping. DataContext: MappingViewModel -->
<UserControl x:Class="PadPilot.App.Views.MappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- One row per button -->
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{local:Tr Heading_ButtonMapping}" Style="{StaticResource Heading}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Width="130" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource EnumLabel}">
                                                <Binding Path="Button" />
                                                <Binding Path="Language" Source="{x:Static local:Loc.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{x:Static local:MappingViewModel.Kinds}" SelectedItem="{Binding Kind}"
                                              MinWidth="150" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{x:Static local:MappingViewModel.Targets}" SelectedItem="{Binding Target}" MinWidth="170"
                                              Visibility="{Binding UsesTarget, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding KeyText}" Style="{StaticResource ActionButton}" MinWidth="170" Margin="0"
                                            Click="CaptureKey_Click" Visibility="{Binding UsesKey, Converter={StaticResource BoolToVisibility}}" />
                                    <ComboBox ItemsSource="{x:Static local:MappingViewModel.MouseActions}" SelectedItem="{Binding Mouse}" MinWidth="170"
                                              Visibility="{Binding UsesMouse, Converter={StaticResource BoolToVisibility}}" />
                                    <ComboBox ItemsSource="{x:Static local:MappingViewModel.SpecialActions}" SelectedItem="{Binding Special}" MinWidth="170"
                                              Visibility="{Binding UsesSpecial, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <!-- Sticks -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr Heading_StickMapping}" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{local:Tr Mapping_LeftStick}" Width="150" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{x:Static local:MappingViewModel.StickModes}" SelectedItem="{Binding LeftStick}" MinWidth="170" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{local:Tr Mapping_RightStick}" Width="150" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{x:Static local:MappingViewModel.StickModes}" SelectedItem="{Binding RightStick}" MinWidth="170" />
                        </StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="{local:Tr Mapping_StickSpeed}" Width="150" />
                            <TextBlock Text="{Binding StickSpeed}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                            <Slider Minimum="1" Maximum="100" Value="{Binding StickSpeed}" />
                        </DockPanel>
                        <TextBlock Text="{local:Tr Mapping_StickHint}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Quick setup -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:Tr Heading_QuickSetup}" Style="{StaticResource Heading}" />
                        <Button Content="{local:Tr Mapping_MicMute}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                Margin="0,0,0,8" Click="MicMute_Click" />
                        <Button Content="{local:Tr Mapping_ResetAll}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                Margin="0,0,0,10" Click="ResetAll_Click" />
                        <TextBlock Text="{local:Tr Mapping_MicHint}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="10,4" Text="{local:Tr Mapping_Hint}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
