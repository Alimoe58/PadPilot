<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PadPilot.Core\PadPilot.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PadPilot</AssemblyName>
    <RootNamespace>PadPilot.App</RootNamespace>
    <!-- Only ship German satellite resources (ours and the framework's); English is built in. -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
