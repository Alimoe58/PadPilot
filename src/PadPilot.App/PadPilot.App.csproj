<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PadPilot.Core\PadPilot.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PadPilot</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Show "1.0.0" in the file properties instead of "1.0.0+<git hash>" -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>PadPilot</Product>
    <Description>DualSense controller tool for Windows</Description>
    <Copyright>Copyright (c) 2026 Alim, MIT License</Copyright>
    <RootNamespace>PadPilot.App</RootNamespace>
    <!-- Only ship German satellite resources (ours and the framework's); English is built in. -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WinForms only for the tray icon (NotifyIcon); keep its namespaces out of the implicit usings -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
