<Application x:Class="PadPilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#1E1F24" />
        <SolidColorBrush x:Key="PanelBrush" Color="#2A2C33" />
        <SolidColorBrush x:Key="TrackBrush" Color="#3A3D46" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA0AA" />

        <local:ScaleConverter x:Key="Scale" />
        <local:ButtonBrushConverter x:Key="ButtonBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EnumLabelConverter x:Key="EnumLabel" />
        <local:StickOffsetConverter x:Key="StickOffset" />
        <local:EqualsVisibilityConverter x:Key="EqualsVisibility" />

        <DataTemplate x:Key="EnumItem">
            <TextBlock Foreground="Black">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource EnumLabel}">
                        <Binding />
                        <Binding Path="Language" Source="{x:Static local:Loc.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Padding="16,8" Margin="6,4,0,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2" Cursor="Hand">
                            <ContentPresenter x:Name="Header" ContentSource="Header" TextElement.FontSize="14"
                                              TextElement.Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="ItemTemplate" Value="{StaticResource EnumItem}" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource TrackBrush}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider rows that don't apply to the chosen trigger effect are dimmed -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Settings for one adaptive trigger (DataContext: TriggerViewModel) -->
        <DataTemplate x:Key="TriggerEditor">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{local:Tr Trigger_Effect}" Width="100" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{x:Static local:TriggerViewModel.Modes}"
                              SelectedItem="{Binding Mode}" />
                </StackPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,4" IsEnabled="{Binding UsesStart}">
                    <TextBlock Text="{local:Tr Trigger_Start}" Width="100" />
                    <TextBlock Text="{Binding Start}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="0" Maximum="9" Value="{Binding Start}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,4" IsEnabled="{Binding UsesEnd}">
                    <TextBlock Text="{local:Tr Trigger_End}" Width="100" />
                    <TextBlock Text="{Binding End}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="0" Maximum="9" Value="{Binding End}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,4" IsEnabled="{Binding UsesStrength}">
                    <TextBlock Text="{local:Tr Trigger_Strength}" Width="100" />
                    <TextBlock Text="{Binding Strength}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="1" Maximum="8" Value="{Binding Strength}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" IsEnabled="{Binding UsesFrequency}">
                    <TextBlock Text="{local:Tr Trigger_Frequency}" Width="100" />
                    <TextBlock Text="{Binding Frequency}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="1" Maximum="60" Value="{Binding Frequency}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Colour swatch for the lightbar; Background holds the colour -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#55FFFFFF" BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <!-- One button indicator; Background is bound per button -->
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="KeyLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
