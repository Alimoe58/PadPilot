<Application x:Class="PadPilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PadPilot.App"
             xmlns:views="clr-namespace:PadPilot.App.Views">
    <Application.Resources>
        <!-- Colours: one dark palette, one accent -->
        <SolidColorBrush x:Key="WindowBrush" Color="#1B1C21" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#202228" />
        <SolidColorBrush x:Key="PanelBrush" Color="#272930" />
        <SolidColorBrush x:Key="HoverBrush" Color="#30333B" />
        <SolidColorBrush x:Key="TrackBrush" Color="#3A3D46" />
        <SolidColorBrush x:Key="BorderBrush" Color="#363941" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="#1E3A63" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6E7EA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA0AA" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <local:ScaleConverter x:Key="Scale" />
        <local:ButtonBrushConverter x:Key="ButtonBrush" />
        <local:BoolVisibilityConverter x:Key="BoolToVisibility" />
        <local:EnumLabelConverter x:Key="EnumLabel" />
        <local:StickOffsetConverter x:Key="StickOffset" />
        <local:EqualsVisibilityConverter x:Key="EqualsVisibility" />
        <local:NotConverter x:Key="Not" />
        <views:PresetProfileConverter x:Key="PresetProfile" />

        <!-- Translated enum value; used by every list of options -->
        <DataTemplate x:Key="EnumItem">
            <TextBlock Foreground="{StaticResource TextBrush}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource EnumLabel}">
                        <Binding />
                        <Binding Path="Language" Source="{x:Static local:Loc.Instance}" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Icon from the Windows icon font; Text holds the glyph -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="8,4,0,8" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>

        <!-- Sidebar: the TabControl's tabs as a vertical list with icons; Tag holds the glyph -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SidebarBrush}" CornerRadius="10" Margin="0,6,6,6" Padding="8">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <DockPanel Grid.Column="1">
                                <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding SelectedItem}" Margin="8,8,0,6">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Header}" FontSize="22" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                                <!-- This name lets accessibility tools (screen readers, automation) see the page's content -->
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </DockPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Item" Padding="10,9" Margin="0,1" CornerRadius="7" Background="Transparent" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" Margin="0,0,12,0" />
                                <ContentPresenter x:Name="Header" ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.FontSize="14" TextElement.Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Item" Property="Background" Value="{StaticResource AccentDimBrush}" />
                                <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <!-- Keyboard users still see where they are -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Item" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every CheckBox is a switch: label left of a sliding knob -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{StaticResource TrackBrush}"
                                    VerticalAlignment="Top" Margin="0,0,10,0">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Player LED dot: lit when checked -->
        <Style x:Key="LedToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Dot" Width="26" Height="10" CornerRadius="5" Background="{StaticResource TrackBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim slider: filled part in the accent colour -->
        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="20">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="{StaticResource AccentBrush}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeat}" Background="{StaticResource TrackBrush}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark dropdown -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{StaticResource TrackBrush}" CornerRadius="6">
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,10,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#454955" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <!-- Screen readers read the translated label, not the internal enum name -->
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource EnumLabel}">
                        <Binding />
                        <Binding Path="Language" Source="{x:Static local:Loc.Instance}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDimBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="ItemTemplate" Value="{StaticResource EnumItem}" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="#2E3038" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360" Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
        </Style>

        <!-- Slim scrollbar without arrows -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#4A4E58" Margin="1,2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="4" Background="#4A4E58" Margin="2,1" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource TrackBrush}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#454955" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one main action on a surface -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource AccentBrush}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="White" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5B97F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round "go to page" button on overview cards -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="26" Height="26" CornerRadius="13" Background="Transparent">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (L2 / R2) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{StaticResource TrackBrush}" CornerRadius="7" Padding="18,6" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider rows that don't apply to the chosen setting are dimmed -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Preset cards: a mini graph plus the name; the chosen one is outlined -->
        <Style x:Key="PresetCards" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource EnumLabel}">
                                    <Binding />
                                    <Binding Path="Language" Source="{x:Static local:Loc.Instance}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Width="128" MinHeight="78" Margin="0,0,8,8" Padding="10,9" CornerRadius="8"
                                            Background="{StaticResource HoverBrush}" BorderBrush="Transparent" BorderThickness="2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="#3A3E48" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel>
                            <views:TriggerGraph Height="22" Profile="{Binding Converter={StaticResource PresetProfile}}" Margin="0,0,0,7" />
                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource EnumLabel}">
                                        <Binding />
                                        <Binding Path="Language" Source="{x:Static local:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One adaptive trigger (DataContext: TriggerViewModel): presets, graph, then the details -->
        <DataTemplate x:Key="TriggerEditor">
            <StackPanel>
                <TextBlock Text="{local:Tr Trigger_Preset}" Style="{StaticResource Heading}" />
                <ListBox ItemsSource="{x:Static local:TriggerPresets.Cards}" SelectedItem="{Binding Preset}" Style="{StaticResource PresetCards}" Margin="0,0,0,10" />

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{local:Tr Trigger_Graph}" Style="{StaticResource Heading}" Margin="0" />
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource EnumLabel}">
                                <Binding Path="Preset" />
                                <Binding Path="Language" Source="{x:Static local:Loc.Instance}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
                <views:TriggerGraph Height="110" Profile="{Binding Current}" Live="{Binding Live}" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="{local:Tr Trigger_Released}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="{local:Tr Trigger_Pressed}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{local:Tr Trigger_Effect}" Width="110" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{x:Static local:TriggerViewModel.Modes}" SelectedItem="{Binding Mode}" MinWidth="240" />
                </StackPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,6" IsEnabled="{Binding UsesStart}">
                    <TextBlock Text="{local:Tr Trigger_Start}" Width="110" />
                    <TextBlock Text="{Binding Start}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="0" Maximum="9" Value="{Binding Start}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,6" IsEnabled="{Binding UsesEnd}">
                    <TextBlock Text="{local:Tr Trigger_End}" Width="110" />
                    <TextBlock Text="{Binding End}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="0" Maximum="9" Value="{Binding End}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,6" IsEnabled="{Binding UsesStrength}">
                    <TextBlock Text="{local:Tr Trigger_Strength}" Width="110" />
                    <TextBlock Text="{Binding Strength}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="1" Maximum="8" Value="{Binding Strength}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,6" IsEnabled="{Binding UsesStrength2}">
                    <TextBlock Text="{Binding Strength2Label}" Width="110" />
                    <TextBlock Text="{Binding Strength2}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="1" Maximum="8" Value="{Binding Strength2}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="0,0,0,6" IsEnabled="{Binding UsesFrequency}">
                    <TextBlock Text="{local:Tr Trigger_Frequency}" Width="110" />
                    <TextBlock Text="{Binding Frequency}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="1" Maximum="60" Value="{Binding Frequency}" />
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" IsEnabled="{Binding UsesPeriod}">
                    <TextBlock Text="{local:Tr Trigger_Period}" Width="110" />
                    <TextBlock Text="{Binding Period}" Width="32" DockPanel.Dock="Right" TextAlignment="Right" />
                    <Slider Minimum="1" Maximum="20" Value="{Binding Period}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Colour swatch for the lightbar; Background holds the colour -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13" BorderBrush="#55FFFFFF" BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One button indicator; Background is bound per button -->
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="KeyLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Application.Resources>
</Application>
